{
  "name": "@eayonlee/dsh-tuitui-bot",
  "version": "0.1.29",
  "private": true,
  "description": "在推推（Tuitui）单聊、群聊与团队频道里直接对话 DeepSeek Harness。 Chat with DeepSeek Harness in Tuitui IM.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "locale",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "CHANGELOG_EN.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20.3.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tuitui",
    "qihoo",
    "im",
    "cordis",
    "plugin",
    "chatbot",
    "tuitui-bot",
    "360"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EayonLee/dsh-tuitui-bot.git"
  },
  "license": "MIT",
  "author": "EayonLee",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json --noEmit && tsdown --config tsdown.client.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:live": "node scripts/smoke-live.mjs",
    "verify": "node scripts/verify-bootstrap.mjs"
  },
  "dependencies": {
    "@qihoo/tuitui-bot-sdk": "1.0.24",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8"
  }
}
